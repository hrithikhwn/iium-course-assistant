# --- LLM: any OpenAI-compatible endpoint ---
# Ollama (default)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=ollama
# Provider options sent with every request, as a JSON object (Ollama needs none)
LLM_EXTRA_BODY=
# Weaker laptop? Use LLM_MODEL=qwen2.5:3b
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1
# Hosted API: set LLM_BASE_URL, LLM_MODEL and LLM_API_KEY from your provider (never commit real keys).
# DeepSeek, for example, which thinks before it answers unless LLM_EXTRA_BODY turns that off:
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=<your DeepSeek API key>
# LLM_EXTRA_BODY='{"thinking": {"type": "disabled"}}'

# --- Embeddings (Ollama) ---
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text
# Task prefixes nomic-embed-text expects; set both empty for other embedding models
EMBED_DOC_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "

# --- Storage ---
RAW_DIR=data/raw
CHROMA_DIR=data/chroma
COURSES_DIR=data/courses
COLLECTION=iium_docs

# --- Retrieval / agent ---
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
# Hybrid search: the best N embedding hits and the best N keyword hits always make the top k
SEARCH_GUARANTEED=2
# Plan step: true = the LLM also rewrites the question into a search query. Off by
# default: in the eval it got no more answers right and cost one LLM call more
QUERY_REWRITE=false
# Grade step: the LLM checks the excerpts and the agent searches again if they're not
# enough. false = plain RAG (one search, then the answer)
GRADING=true
# Strict: say "not found" when the last grade still fails (needs GRADING=true)
REFUSE_ON_FAILED_GRADE=false
MAX_RETRIES=2
# Most excerpt text per prompt. Ollama gives models a 4096-token window by default and
# silently cuts longer prompts (the instructions are lost). To raise this, also start
# Ollama with a bigger window, e.g. OLLAMA_CONTEXT_LENGTH=8192, and roughly double it.
MAX_CONTEXT_CHARS=11000
